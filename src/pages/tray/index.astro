---
import Icon from "../../components/ui/Icon.astro";
import Slider from "../../components/ui/Slider.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChannelIconTemplate from "../../components/mixer/ChannelIconTemplate.astro";
---

<BaseLayout title="Volt Mixer tray" description="The desktop app's tray mixer for Volt Mixer." isIndexed={false}>
    <div class="tray">
        <div class="head">
            <h1>Volt Mixer</h1>
            <span class="status" role="status" data-tray-status>
                Waiting for Volt Mixer…
            </span>
        </div>
        <div class="body">
            <div data-tray-content>
                <ul class="rows" data-tray-rows></ul>
                <p class="note" data-tray-note hidden></p>
            </div>
        </div>
        <div class="foot">
            <a class="button" href={import.meta.env.BASE_URL} data-tray-open>
                Open Volt Mixer
            </a>
            <button class="button button--icon" type="button" data-tray-close hidden>
                <Icon name="close" />
                <span class="visually-hidden">Close</span>
            </button>
        </div>
    </div>

    <!-- A row: what it is (icon, with its name for screen readers), mute, and its level. -->
    <template id="tray-row-template">
        <li class="row" data-tray-row>
            <span class="what" data-row-icon></span>
            <span class="visually-hidden" data-row-name></span>
            <button class="button button--icon mute" type="button" aria-pressed="false" data-row-action="mute">
                <Icon name="volume-2" class="unmuted" />
                <Icon name="volume-x" class="muted" />
            </button>
            <!-- Analog inputs: the Volt's DIRECT monitoring, lit while on (as on the page's strips). -->
            <button
                class="button button--icon direct"
                type="button"
                aria-pressed="false"
                data-row-action="direct"
                hidden>
                <Icon name="ear" />
            </button>
            <Slider kind="fader" name="row" class="row-slider" />
        </li>
    </template>

    <ChannelIconTemplate />
</BaseLayout>

<script>
    import { startTray } from "../../scripts/tray.ts";

    startTray();
</script>

<style>
    /* A fixed column: the header and footer stay, only the rows scroll (docs/decisions.md). */
    .tray {
        position: fixed;
        inset: 0;
        display: grid;
        grid-template-rows: auto minmax(0, 1fr) auto;
        background-color: var(--color-background-surface);
    }

    .head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0 var(--space-between-content);
        padding: var(--space-padding-compact) var(--space-padding-container);
        border-block-end: var(--border-width-default) solid var(--color-border-subtle);
    }

    h1 {
        font-size: var(--font-size-heading);
    }

    /* The same colours as the main window's status. */
    .status {
        color: var(--color-text-secondary);
        font-size: var(--font-size-small);

        &[data-status="on"] {
            color: var(--color-text-success);
        }

        &[data-status="away"] {
            color: var(--color-text-warning);
        }
    }

    /* Room above the first row for its value bubble. */
    .body {
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: var(--space-between-blocks) var(--space-padding-container) var(--space-padding-compact);
    }

    .rows {
        display: grid;
        gap: var(--space-between-content);
        padding: 0;
        list-style: none;
    }

    .row {
        display: grid;
        grid-template-columns: auto auto minmax(0, 1fr);
        align-items: center;
        gap: var(--space-between-text);
    }

    .what {
        display: grid;
        place-items: center;
        color: var(--color-text-secondary);

        & :global(.icon) {
            inline-size: var(--size-icon);
            block-size: var(--size-icon);
        }
    }

    /* A speaker, struck through while muted; the button's pressed state says which. */
    .mute {
        border-color: transparent;
        background-color: transparent;

        & :global(.muted) {
            display: none;
        }

        &[aria-pressed="true"] {
            color: var(--color-background-danger);

            & :global(.muted) {
                display: inline-block;
            }

            & :global(.unmuted) {
                display: none;
            }
        }
    }

    /*
     * No value beside the slider: it shows in a bubble above the handle while the handle is held
     * or moved with the keyboard. The slider's own readout becomes the bubble.
     */
    .row :global(.slider) {
        position: relative;
        grid-template: "control" var(--size-slider-thumb) / 1fr;
    }

    .row :global(.value) {
        position: absolute;
        inset-block-end: calc(100% + var(--space-between-lines));
        inset-inline-start: calc(var(--slider-position) * var(--slider-travel) + var(--size-slider-thumb) / 2);
        padding: 0.125rem var(--space-between-text);
        border: var(--border-width-default) solid var(--color-border-subtle);
        border-radius: var(--radius-small);
        background-color: var(--color-background-raised);
        color: var(--color-text-primary);
        white-space: nowrap;
        translate: -50% 0;
        visibility: hidden;
    }

    .row :global(.slider:has(.control:focus-visible, .control[data-dragging])) :global(.value) {
        visibility: visible;
    }

    /* The TONE colours, as on the page's strips. */
    [data-tone="warmth"] {
        --slider-colour: var(--color-fader-warmth);
    }

    [data-tone="focus"] {
        --slider-colour: var(--color-fader-focus);
    }

    [data-tone="shine"] {
        --slider-colour: var(--color-fader-shine);
    }

    .note {
        margin-block-start: var(--space-between-content);
        color: var(--color-text-secondary);
        font-size: var(--font-size-small);
    }

    .foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-between-text);
        padding: var(--space-padding-compact) var(--space-padding-container);
        border-block-start: var(--border-width-default) solid var(--color-border-subtle);
    }
</style>
