---
import sizes from "../../data/guide-images.json";

/*
 * A screenshot from tools/guide-images.mjs, in light and dark to match the page; its size comes
 * from the list the tool writes (src/data/guide-images.json).
 */

interface Props {
    /** The shot's name in src/data/guide-images.json. */
    name: string;
    alt: string;
    caption?: string;
}

const { name, alt, caption } = Astro.props;
const folder = `${import.meta.env.BASE_URL}guide/images/`;
const size = (sizes as Record<string, { width: number; height: number }>)[name];
if (!size) throw new Error(`No screenshot named "${name}": run tools/guide-images.mjs.`);
---

<figure class="shot">
    {(["light", "dark"] as const).map((theme) => (
        <img
            class={`shot-${theme}`}
            src={`${folder}${name}-${theme}.webp`}
            alt={alt}
            width={size.width}
            height={size.height}
            loading="lazy"
            decoding="async"
        />
    ))}
    {caption && <figcaption>{caption}</figcaption>}
</figure>
