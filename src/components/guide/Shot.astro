---
import sizes from "../../data/guide-images.json";

/*
 * A screenshot from tools/guide-images.mjs, in light and dark to match the page; its size comes
 * from the list the tool writes (src/data/guide-images.json). `file` shows one image as it is.
 */

interface Props {
    /** The shot's name in src/data/guide-images.json. */
    name?: string;
    /** Or one image in public/guide/images, with its size. */
    file?: string;
    width?: number;
    height?: number;
    alt: string;
    caption?: string;
}

const { name, file, alt, caption } = Astro.props;
const folder = `${import.meta.env.BASE_URL}guide/images/`;
const size = name ? (sizes as Record<string, { width: number; height: number }>)[name] : undefined;
if (name && !size) throw new Error(`No screenshot named "${name}": run tools/guide-images.mjs.`);
const width = size?.width ?? Astro.props.width;
const height = size?.height ?? Astro.props.height;
const images = name
    ? (["light", "dark"] as const).map((theme) => ({ src: `${folder}${name}-${theme}.webp`, theme }))
    : [{ src: `${folder}${file}`, theme: undefined }];
---

<figure class="shot">
    {images.map(({ src, theme }) => (
        <img
            class={theme && `shot-${theme}`}
            src={src}
            alt={alt}
            width={width}
            height={height}
            loading="lazy"
            decoding="async"
        />
    ))}
    {caption && <figcaption>{caption}</figcaption>}
</figure>
