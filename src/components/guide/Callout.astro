---
import Icon from "../ui/Icon.astro";

/*
 * A tip, note or caution in the guide, drawn exactly like the mixer's notice bar
 * (.message-box, src/styles/message.css). Without a title it is a notice, as the mixer shows one.
 * Its kind is said to screen readers either way, as the icon and colour say it to the eye.
 */

interface Props {
    kind?: "tip" | "note" | "caution";
    title?: string;
}

const kinds = {
    tip: { message: "success", icon: "circle-check", label: "Tip" },
    note: { message: "info", icon: "info", label: "Note" },
    caution: { message: "warning", icon: "triangle-alert", label: "Caution" },
};
const { kind = "note", title } = Astro.props;
const { message, icon, label } = kinds[kind];
---

<div class="message-box callout" data-kind={message}>
    <span class="message-icon">
        <Icon name={icon} />
    </span>
    <div class="callout-body">
        {title ? (
            <p class="callout-title">
                <span class="visually-hidden">{label}:</span> {title}
            </p>
        ) : (
            <span class="visually-hidden">{label}:</span>
        )}
        <slot />
    </div>
</div>
