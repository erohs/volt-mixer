---
import Icon from "../ui/Icon.astro";

const messageIcons = ["circle-check", "info", "triangle-alert", "circle-x"];
---

<!--
    Messages about the whole page: always in it, empty when idle, so a new one is announced (urgent
    for warnings and errors). Every message gets a Dismiss button, cloned from the template by
    notice() in src/scripts/app-state.ts; its kind's icon comes from #message-icons.
-->
<div class="notice message-box" aria-live="polite" data-notice></div>
<template id="notice-dismiss">
    <button class="button button--icon dismiss" type="button" data-notice-dismiss>
        <Icon name="close" />
        <span class="visually-hidden">Dismiss</span>
    </button>
</template>
<template id="message-icons">
    {messageIcons.map((name) => (
        <span data-icon-name={name}>
            <Icon name={name} />
        </span>
    ))}
</template>

<style>
    /* The box itself is shared with the guide's tips (.message-box, src/styles/message.css). */
    .notice:not(:empty) {
        margin: var(--space-between-blocks) var(--space-page-inline) 0;
    }

    /* Wider than body text: a notice is one or two sentences, best read on one line. */
    .notice :global(.notice-text) {
        max-inline-size: 90ch;
    }

    /* At the far end, whatever the message's length. */
    .dismiss {
        flex-shrink: 0;
        margin-inline-start: auto;
        border-color: transparent;
        background-color: transparent;
    }
</style>
