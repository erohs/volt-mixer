---
import Icon from "../ui/Icon.astro";
---

<!--
    Short confirmations and hints (src/scripts/toast.ts). A popover, so it sits in the top layer
    above an open dialog, where the notice bar can't be seen. Lasting problems use the notice bar.
    A hidden popover isn't in the accessibility tree, so each toast is announced through a live
    region that always is.
-->
<div class="toast" popover="manual" data-toast>
    <p class="text" data-toast-text></p>
    <button class="button button--icon dismiss" type="button" data-toast-dismiss>
        <Icon name="close" />
        <span class="visually-hidden">Dismiss</span>
    </button>
</div>
<p class="visually-hidden" role="status" data-toast-announce></p>

<style>
    .toast:popover-open {
        display: flex;
        align-items: center;
        gap: var(--space-between-text);
    }

    .toast {
        inset: auto 0 var(--space-padding-page);
        max-inline-size: min(28rem, calc(100vw - 2 * var(--space-padding-page)));
        margin-inline: auto;
        padding: var(--space-between-lines) var(--space-between-lines) var(--space-between-lines)
            var(--space-padding-container);
        border: var(--border-width-default) solid var(--color-border-subtle);
        border-radius: var(--radius-medium);
        background-color: var(--color-background-raised);
        color: var(--color-text-primary);
        box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 25%);
        font-size: var(--font-size-small);
    }

    /* At the far end, like the notice bar's. */
    .dismiss {
        flex-shrink: 0;
        margin-inline-start: auto;
        border-color: transparent;
        background-color: transparent;
    }
</style>
