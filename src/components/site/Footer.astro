---
import { site } from "../../lib/site.ts";
import Icon from "../ui/Icon.astro";

const base = import.meta.env.BASE_URL;
---

<!-- What this is, then a few links, the guide first. The licence and supported models are on GitHub. -->
<footer class="footer">
    <!-- Says what this is in plain words: much of the mixer page is controls, so this is what search engines read. -->
    <p class="about">
        Volt Mixer controls the built-in mixer of the Universal Audio Volt 4 Gen 2 from Edge or Chrome, without UAD
        Console. Free and open source; not affiliated with Universal Audio.
    </p>
    <ul class="links">
        <li>
            <a class="guide" href={`${base}${site.guidePath}`}>
                Guide
                <Icon name="arrow-right" />
            </a>
        </li>
        <li>
            <a href={site.releasesUrl}>Desktop app</a>
        </li>
        <li>
            <a href={`${base}${site.privacyPath}`}>Privacy</a>
        </li>
        <li>
            <a href={site.repositoryUrl}>GitHub</a>
        </li>
    </ul>
</footer>

<style>
    .footer {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--space-between-text) var(--space-between-blocks);
        margin-inline: var(--space-page-inline);
        padding-block: var(--space-padding-container) var(--space-padding-page);
        border-block-start: var(--border-width-default) solid var(--color-border-subtle);
        color: var(--color-text-secondary);
        font-size: var(--font-size-small);
    }

    .links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-between-lines) var(--space-between-content);
        padding: 0;
        list-style: none;
    }

    a {
        color: var(--color-text-secondary);
        text-underline-offset: 0.2em;

        &:hover {
            color: var(--color-text-primary);
        }
    }

    /* The guide stands out: it's where to go next. */
    .guide {
        display: inline-flex;
        align-items: center;
        gap: var(--space-between-lines);
        color: var(--color-text-accent);
        font-weight: var(--font-weight-semi-bold);

        &:hover {
            color: var(--color-text-accent);
        }
    }
</style>
