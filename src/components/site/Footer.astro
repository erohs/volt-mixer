---
import { site } from "../../lib/site.ts";
---

<footer class="footer">
    <p>
        Volt Mixer controls the built-in mixer of a Universal Audio Volt 4 Gen 2 from Microsoft Edge or Google Chrome,
        without UAD Console. It talks to the Volt over USB through WebHID, so there's nothing to install. Free and open
        source.
    </p>
    <ul class="links">
        <li>
            <a href={site.repositoryUrl}>Source on GitHub</a>
        </li>
        <li>
            <a href={site.supportedModelsUrl}>Supported models</a>
        </li>
        <li>
            <a href={site.licenceUrl}>MIT licence</a>
        </li>
    </ul>
</footer>

<style>
    .footer {
        display: grid;
        gap: var(--space-between-text);
        margin-inline: var(--space-padding-page);
        padding-block: var(--space-padding-container) var(--space-padding-page);
        border-block-start: var(--border-width-default) solid var(--color-border-subtle);
        color: var(--color-text-secondary);
        font-size: var(--font-size-small);
    }

    .links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-between-lines) var(--space-between-content);
        padding: 0;
        list-style: none;
    }

    a {
        color: var(--color-text-accent);
        text-underline-offset: 0.2em;
    }
</style>
