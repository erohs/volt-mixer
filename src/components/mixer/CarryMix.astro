---
import FeedbackButton from "../ui/FeedbackButton.astro";
import InlineMessage from "../ui/InlineMessage.astro";
import QrCode from "../ui/QrCode.astro";

/* Why this browser can't do it, said the same way in both parts. */
const whyNotHere =
    "To control your Volt, open Volt Mixer in Microsoft Edge or Google Chrome on the computer it's plugged " +
    "into. Firefox, Safari and phones can't talk to USB devices.";
---

<!--
    Shown in a browser that can't reach a Volt (a phone, Firefox, Safari), with one of its two parts.
    With a mix link it has been given, it carries the mix to a computer that can: a QR code to scan
    there. Without one, it says what a phone can do. src/scripts/carry-mix.ts.
-->
<div class="carry message-box message-box--panel" data-carry hidden>
    <section class="carry-part" aria-labelledby="carry-heading" data-carry-mix hidden>
        <h2 id="carry-heading">Your mix is on this device</h2>
        <p>{whyNotHere}</p>
        <p>
            Take your mix there: scan this code with that computer's camera, or send yourself the link and open it
            there.
        </p>
        <QrCode name="carry" label="QR code of your mix link">
            <p class="hint">It stays here, so you can open Volt Mixer on this device and show it again.</p>
        </QrCode>
        <div class="actions">
            <button class="button button--primary" type="button" data-carry-share hidden>
                Send the link
            </button>
            <FeedbackButton data-carry-copy>Copy the link</FeedbackButton>
            <button class="button" type="button" data-carry-forget>
                Forget it
            </button>
        </div>
        <InlineMessage name="carry" />
    </section>
    <section class="carry-part" aria-labelledby="carry-none-heading" data-carry-none hidden>
        <h2 id="carry-none-heading">Volt Mixer can't reach a Volt from here</h2>
        <p>{whyNotHere}</p>
        <p>On a phone, you can still:</p>
        <ul class="carry-list">
            <li>
                <strong>Carry a mix to another computer.</strong> On a computer with Volt Mixer, open Settings › Your
                mix › QR code, and scan it with this phone.
            </li>
            <li>
                <strong>Change levels from here.</strong> In the desktop app, turn on Settings › Desktop app › Phone
                remote, and scan its QR code.
            </li>
        </ul>
    </section>
</div>

<style>
    .carry:not([hidden]) {
        margin-block-start: var(--space-between-blocks);
        margin-inline: var(--space-page-inline);
    }

    .carry-part:not([hidden]) {
        display: grid;
        gap: var(--space-between-content);
    }

    .carry-list {
        display: grid;
        gap: var(--space-between-text);
        padding-inline-start: 1.25rem;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-between-text);
    }
</style>
