---
import Icon from "../ui/Icon.astro";
import Meter from "../ui/Meter.astro";
import Slider from "../ui/Slider.astro";

const levelTicks = [0, 25, 50, 75, 100].map((level) => ({ label: `${level}`, position: level / 100 }));
---

<section class="outputs" aria-labelledby="outputs-heading">
    <h2 id="outputs-heading">Outputs</h2>
    <!--
        The Volt meters its monitor mix before the Monitor level, which is also what the headphones
        hear while their cue follows the monitor mix. It reports no other output meter.
    -->
    <div class="mix">
        <span class="mix-name">Mix</span>
        <span class="side">L</span>
        <Meter name="monitorL" orientation="horizontal" />
        <span class="side">R</span>
        <Meter name="monitorR" orientation="horizontal" />
    </div>
    <!-- Each button is named with its output ("Mute Monitor"), so the two Mutes can be told apart. -->
    <div class="cards">
        <article class="output" data-output="monitor" aria-labelledby="monitor-heading">
            <div class="head">
                <h3 class="output-title" id="monitor-heading">
                    <Icon name="speaker" />
                    Monitor
                </h3>
                <button
                    id="monitor-mute"
                    class="button button--mute"
                    type="button"
                    aria-pressed="false"
                    aria-labelledby="monitor-mute monitor-heading"
                    data-action="monitor-mute">
                    Mute
                </button>
                <button
                    id="monitor-mono"
                    class="button"
                    type="button"
                    aria-pressed="false"
                    aria-labelledby="monitor-mono monitor-heading"
                    data-action="monitor-mono">
                    Mono
                </button>
            </div>
            <Slider kind="level" name="monitor-level" labelledBy="monitor-heading" ticks={levelTicks} />
        </article>
        <article class="output" data-output="headphone" aria-labelledby="headphone-heading">
            <div class="head">
                <h3 class="output-title" id="headphone-heading">
                    <Icon name="headphones" />
                    Headphones
                </h3>
                <button
                    id="headphone-mute"
                    class="button button--mute"
                    type="button"
                    aria-pressed="false"
                    aria-labelledby="headphone-mute headphone-heading"
                    data-action="headphone-mute">
                    Mute
                </button>
            </div>
            <Slider kind="level" name="headphone-level" labelledBy="headphone-heading" ticks={levelTicks} />
        </article>
    </div>
</section>

<style>
    /* Titled like Channels, with the same gap below, so both lists of cards start level. */
    .outputs {
        display: grid;
        gap: var(--space-between-content);
        align-content: start;
    }

    /* Side by side when there's room above the channels; stacked in the narrow right column. */
    .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
        gap: var(--space-between-content);
    }

    .output {
        display: grid;
        gap: var(--space-between-content);
        padding: var(--space-padding-container);
        border: var(--border-width-default) solid var(--color-border-subtle);
        border-radius: var(--radius-large);
        background-color: var(--color-background-surface);
    }

    .head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-between-text);
    }

    .output-title {
        display: flex;
        flex-grow: 1;
        align-items: center;
        gap: var(--space-between-text);
    }

    /* The Volt's Monitor/Headphone button: green for monitors, amber for headphones (the title's Icon). */
    .output[data-output="monitor"] .output-title > :global(.icon) {
        color: var(--color-monitor);
    }

    .output[data-output="headphone"] .output-title > :global(.icon) {
        color: var(--color-headphone);
    }

    /* "Mix" spanning both rows, then a small L and R before each meter. */
    .mix {
        display: grid;
        grid-template-columns: auto auto minmax(0, 1fr);
        align-items: center;
        gap: var(--space-between-meters) var(--space-between-text);
        color: var(--color-text-secondary);
        font-size: var(--font-size-small);
    }

    .mix-name {
        grid-row: span 2;
        font-weight: var(--font-weight-semi-bold);
    }

    .side {
        font-size: var(--font-size-meta);
    }
</style>
