---
import { faderTicks } from "../../lib/taper.ts";
import Icon from "../ui/Icon.astro";
import Meter from "../ui/Meter.astro";
import Slider from "../ui/Slider.astro";
---

<!--
    Cloned once per channel strip by src/scripts/strips.ts, which fills in the name, the meters'
    names and the labels. A stereo strip keeps both meters; a mono one hides the second.
-->
<template id="strip-template">
    <li class="strip" data-strip>
        <div class="head">
            <h3 class="name">
                <span class="strip-icon" data-strip-icon></span>
                <span data-strip-name></span>
                <span class="visually-hidden" data-strip-tone-name></span>
            </h3>
            <!-- Analog inputs only: what the input is, and its 48V (which works like the 48V button). -->
            <div class="tags" data-strip-tags hidden>
                <span class="tag" data-strip-input></span>
                <button class="tag tag--phantom" type="button" aria-pressed="false" data-strip-action="phantom">
                    48V
                </button>
            </div>
            <button class="button button--icon gear" type="button" aria-haspopup="dialog" data-strip-action="settings">
                <Icon name="settings" />
                <span class="visually-hidden" data-strip-settings-label>
                    Channel settings
                </span>
            </button>
        </div>
        <div class="fader">
            <Slider kind="fader" name="fader" orientation="vertical" ticks={faderTicks()} />
            <div class="meters">
                <Meter name="" />
                <Meter name="" />
            </div>
        </div>
        <div class="actions">
            <!-- A speaker, struck through while muted. On Inputs 1-4 this is the Volt's DIRECT. -->
            <button
                class="button button--icon button--mute"
                type="button"
                aria-pressed="false"
                data-strip-action="mute">
                <Icon name="volume-2" class="unmuted" />
                <Icon name="volume-x" class="muted" />
            </button>
            <button class="button button--solo" type="button" aria-pressed="false" data-strip-action="solo">
                S
            </button>
            <button class="button button--icon" type="button" aria-pressed="false" data-strip-action="link">
                <Icon name="link" />
            </button>
        </div>
    </li>
</template>

<style>
    /*
     * Each strip spans three rows of the strip list's grid in src/pages/index.astro (head, fader,
     * buttons) as a subgrid, so they line up across strips even when a name wraps.
     */
    .strip {
        position: relative;
        display: grid;
        grid-row: span 3;
        grid-template-rows: subgrid;
        gap: var(--space-between-text);
        padding: var(--space-padding-compact);
        border: var(--border-width-default) solid var(--color-border-subtle);
        border-radius: var(--radius-large);
        background-color: var(--color-background-surface);
    }

    /* Pinned to the top of its row, so a longer name in another strip can't push this one down. */
    .head {
        align-self: start;
        padding-inline-end: calc(var(--size-icon) + var(--space-between-lines));
    }

    .name {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.125rem var(--space-between-lines);
        font-size: var(--font-size-body);
        overflow-wrap: anywhere;
    }

    /* With TONE on, the fader takes the colour of the Volt's TONE ring; off, it keeps the accent. */
    [data-tone="warmth"] {
        --slider-colour: var(--color-fader-warmth);
    }

    [data-tone="focus"] {
        --slider-colour: var(--color-fader-focus);
    }

    [data-tone="shine"] {
        --slider-colour: var(--color-fader-shine);
    }

    /* The channel's icon, quiet beside its name. */
    .strip-icon {
        display: inline-grid;
        color: var(--color-text-secondary);

        & :global(.icon) {
            inline-size: 1.125rem;
            block-size: 1.125rem;
        }
    }

    /* Small and quiet, so they never compete with the fader. */
    /* Below the name everything is centred on the strip, so the tags reach under the gear too. */
    .tags:not([hidden]) {
        display: flex;
        justify-content: center;
        gap: var(--space-between-lines);
        margin-block-start: var(--space-between-text);
        margin-inline-end: calc(-1 * (var(--size-icon) + var(--space-between-lines)));
    }

    .tag {
        min-inline-size: 2.25rem;
        padding: 0 0.25rem;
        border: var(--border-width-default) solid var(--color-border-subtle);
        border-radius: 4px;
        background-color: transparent;
        font-size: var(--font-size-meta);
        font-weight: var(--font-weight-semi-bold);
        line-height: 1.125rem;
        text-align: center;
        text-transform: uppercase;

        &[data-input="mic"] {
            color: var(--color-text-mic);
        }

        &[data-input="line"] {
            color: var(--color-text-line);
        }
    }

    /* 48V: dim while off, lit red like the Volt's 48V label while on; line inputs have none. */
    .tag--phantom {
        color: var(--color-text-secondary);
        cursor: pointer;

        &[aria-pressed="true"] {
            border-color: var(--color-background-danger);
            background-color: var(--color-background-danger);
            color: var(--color-text-on-danger);
        }

        &:disabled {
            cursor: default;
            opacity: 0.5;
        }

        &:focus-visible {
            outline-offset: 1px;
        }
    }

    /* A quiet gear in the corner, partly in the padding, so the name keeps the width. */
    .gear {
        position: absolute;
        /* Centred on the name's first line: the padding plus half a line, less half the button. */
        inset-block-start: calc(var(--space-padding-compact) + 0.6875rem - 1rem);
        inset-inline-end: var(--space-between-lines);
        min-inline-size: 2rem;
        min-block-size: 2rem;
        border-color: transparent;
        background-color: transparent;
        color: var(--color-text-secondary);

        &:hover {
            color: var(--color-text-primary);
        }
    }

    /*
     * The fader, its scale and the meters are one centred block. The dB readout is centred under
     * that whole block, not just the slider, so it lines up with the tags and buttons.
     */
    .fader {
        position: relative;
        display: flex;
        justify-content: center;
        gap: var(--space-between-text);
        padding-block-end: calc(var(--font-size-small) * var(--line-height-body) + var(--space-between-lines));

        & :global(.value) {
            position: absolute;
            inset-inline: 0;
            inset-block-end: 0;
            text-align: center;
        }
    }

    .meters {
        display: flex;
        gap: 3px;
        block-size: var(--size-fader-length);
        padding-block: calc(var(--size-slider-thumb) / 2);

        & :global([data-meter=""]) {
            display: none;
        }

        /* No meters at all (the Volt has none for this channel): no gap beside the fader either. */
        &:not(:has(:global([data-meter]:not([data-meter=""])))) {
            display: none;
        }
    }

    /* M, S and Link are equal squares on one line, so every strip's button row matches. */
    .actions {
        display: flex;
        justify-content: center;
        gap: var(--space-between-lines);

        & .button {
            inline-size: var(--size-action-minimum);
            padding: 0;
        }
    }

    .button--mute :global(.muted),
    .button--mute[aria-pressed="true"] :global(.unmuted) {
        display: none;
    }

    .button--mute[aria-pressed="true"] :global(.muted) {
        display: inline-block;
    }
</style>
