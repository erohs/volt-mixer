---
import { faderTicks } from "../../lib/taper.ts";
import Icon from "../ui/Icon.astro";
import Meter from "../ui/Meter.astro";
import Slider from "../ui/Slider.astro";
---

<!--
    Cloned once per channel strip by src/scripts/strips.ts, which fills in the name, the meters'
    names and the labels. A stereo strip keeps both meters; a mono one hides the second.
-->
<template id="strip-template">
    <li class="strip" data-strip>
        <div class="head">
            <h3 class="name">
                <span class="strip-icon" data-strip-icon></span>
                <span data-strip-name></span>
            </h3>
            <!-- Straight after the name, so Tab reaches it before the tags (it's drawn in the corner). -->
            <button class="button button--icon gear" type="button" aria-haspopup="dialog" data-strip-action="settings">
                <Icon name="settings" />
                <span class="visually-hidden" data-strip-settings-label>
                    Channel settings
                </span>
            </button>
            <!-- Analog inputs only: the TONE (a press steps to the next one) and the 48V. -->
            <div class="tags" data-strip-tags hidden>
                <button class="button button--tag button--tone" type="button" data-strip-action="tone">
                    <span data-strip-tone>Off</span>
                </button>
                <button
                    class="button button--tag button--phantom"
                    type="button"
                    aria-pressed="false"
                    data-strip-action="phantom">
                    48V
                </button>
            </div>
        </div>
        <div class="fader">
            <Slider kind="fader" name="fader" orientation="vertical" ticks={faderTicks()} />
            <div class="meters">
                <Meter name="" />
                <Meter name="" />
            </div>
        </div>
        <div class="actions">
            <!-- A speaker, struck through while muted. On Inputs 1-4 this is the Volt's DIRECT. -->
            <button
                class="button button--icon button--mute action"
                type="button"
                aria-pressed="false"
                data-strip-action="mute">
                <Icon name="volume-2" class="unmuted" />
                <Icon name="volume-x" class="muted" />
            </button>
            <button class="button button--solo action" type="button" aria-pressed="false" data-strip-action="solo">
                S
            </button>
            <button class="button button--icon action" type="button" aria-pressed="false" data-strip-action="link">
                <Icon name="link" />
            </button>
        </div>
    </li>
</template>

<style>
    /*
     * Each strip spans three rows of the strip list's grid in src/pages/index.astro (head, fader,
     * buttons) as a subgrid, so they line up across strips even when a name wraps. With TONE on
     * (data-tone, set by the script) its fader takes the TONE ring's colour (src/styles/tone.css).
     */
    .strip {
        position: relative;
        display: grid;
        grid-row: span 3;
        grid-template-rows: subgrid;
        gap: var(--space-between-text);
        padding: var(--space-padding-compact);
        border: var(--border-width-default) solid var(--color-border-subtle);
        border-radius: var(--radius-large);
        background-color: var(--color-background-surface);
    }

    /* Pinned to the top of its row, so a longer name in another strip can't push this one down. */
    .head {
        align-self: start;
        padding-inline-end: calc(var(--size-icon) + var(--space-between-lines));
    }

    .name {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.125rem var(--space-between-lines);
        font-size: var(--font-size-body);
        overflow-wrap: anywhere;
    }

    /* The channel's icon (cloned in by the script), quiet beside its name. */
    .strip-icon {
        display: inline-grid;
        color: var(--color-text-secondary);
    }

    .strip-icon > :global(.icon) {
        inline-size: 1.125rem;
        block-size: 1.125rem;
    }

    /*
     * TONE and 48V (.button--tag): small and quiet, so they never compete with the fader. Below the
     * name everything is centred on the strip, so the tags reach under the gear too.
     */
    .tags:not([hidden]) {
        display: flex;
        justify-content: center;
        gap: var(--space-between-lines);
        margin-block-start: var(--space-between-text);
        margin-inline-end: calc(-1 * (var(--size-icon) + var(--space-between-lines)));
    }

    /* A quiet gear in the corner, partly in the padding, so the name keeps the width. */
    .gear {
        position: absolute;
        /* Centred on the name's first line: the padding plus half a line, less half the button. */
        inset-block-start: calc(var(--space-padding-compact) + 0.6875rem - 1rem);
        inset-inline-end: var(--space-between-lines);
        min-inline-size: 2rem;
        min-block-size: 2rem;
        border-color: transparent;
        background-color: transparent;
        color: var(--color-text-secondary);
    }

    .gear:hover {
        color: var(--color-text-primary);
    }

    /*
     * The fader, its scale and the meters are one centred block. The dB readout (the Slider's
     * own) is centred under that whole block, not just the slider, so it lines up with the tags
     * and buttons.
     */
    .fader {
        position: relative;
        display: flex;
        justify-content: center;
        gap: var(--space-between-text);
        padding-block-end: calc(var(--font-size-small) * var(--line-height-body) + var(--space-between-lines));
    }

    .fader > :global(.slider) > :global(.value) {
        position: absolute;
        inset-inline: 0;
        inset-block-end: 0;
        text-align: center;
    }

    .meters {
        display: flex;
        gap: var(--space-between-meters);
        block-size: var(--size-fader-length);
        padding-block: calc(var(--size-slider-thumb) / 2);
    }

    /* A mono strip has no name for its second meter, so it isn't shown. */
    .meters > :global([data-meter=""]) {
        display: none;
    }

    /* No meters at all (the Volt has none for this channel): no gap beside the fader either. */
    .meters:not(:has(> :global([data-meter]:not([data-meter=""])))) {
        display: none;
    }

    /* M, S and Link are equal squares on one line, so every strip's button row matches. */
    .actions {
        display: flex;
        justify-content: center;
        gap: var(--space-between-lines);
    }

    .action {
        inline-size: var(--size-action-minimum);
        padding: 0;
    }

    /* A speaker, struck through while muted. */
    .button--mute > :global(.muted),
    .button--mute[aria-pressed="true"] > :global(.unmuted) {
        display: none;
    }

    .button--mute[aria-pressed="true"] > :global(.muted) {
        display: inline-block;
    }
</style>
