---
import Dialog from "../ui/Dialog.astro";
import FeedbackButton from "../ui/FeedbackButton.astro";
import Icon from "../ui/Icon.astro";
import InlineMessage from "../ui/InlineMessage.astro";
import LinkField from "../ui/LinkField.astro";
import MixPasteForm from "./MixPasteForm.astro";
import PhoneRemote from "./PhoneRemote.astro";
import QrCode from "../ui/QrCode.astro";
import Reveal from "../ui/Reveal.astro";
import SettingGroup from "../ui/SettingGroup.astro";
import SettingRow from "../ui/SettingRow.astro";
import { site } from "../../lib/site.ts";
import Slider from "../ui/Slider.astro";
---

<Dialog id="settings-dialog" title="Settings">
    <SettingGroup id="device" title="Device">
        <SettingRow id="clip" name="Clip Protection" description="Limits sudden peaks." for="clip-input">
            <input
                id="clip-input"
                type="checkbox"
                role="switch"
                aria-describedby="clip-description"
                data-setting="clip"
            />
        </SettingRow>
        <SettingRow id="brightness" name="Display brightness">
            <Slider kind="brightness" name="brightness" labelledBy="brightness-name" />
        </SettingRow>
        <SettingRow id="digital" name="Digital input" description="Optical port format." for="digital-input">
            <select id="digital-input" aria-describedby="digital-description" data-setting="digital">
                <option value="adat">ADAT</option>
                <option value="spdif">S/PDIF</option>
            </select>
        </SettingRow>
        <SettingRow id="identify" name="Find this Volt" description="Flashes its lights.">
            <button class="button" type="button" aria-describedby="identify-description" data-action="identify">
                Identify
            </button>
        </SettingRow>
    </SettingGroup>

    <SettingGroup id="routing" title="Cues and headphones">
        <SettingRow
            id="headphone-source"
            name="Headphones"
            description="Which cue you hear."
            for="headphone-source-input">
            <select
                id="headphone-source-input"
                aria-describedby="headphone-source-description"
                data-setting="headphone-source">
                <option value="cue1">Cue 1</option>
                <option value="cue2">Cue 2</option>
            </select>
        </SettingRow>
        {["cue1", "cue2"].map((cue, index) => (
            <SettingRow
                id={`${cue}-source`}
                name={`Cue ${index + 1}`}
                description="Monitor mix or its own sends."
                for={`${cue}-source-input`}>
                <select
                    id={`${cue}-source-input`}
                    aria-describedby={`${cue}-source-description`}
                    data-setting={`${cue}-source`}>
                    <option value="mix">Monitor mix</option>
                    <option value="own">Own mix</option>
                </select>
            </SettingRow>
        ))}
        <SettingRow id="mirror" name="Line Out 3/4" description="The rear line outputs." for="mirror-input">
            <select id="mirror-input" aria-describedby="mirror-description" data-setting="mirror">
                <option value="none">Computer playback</option>
                <option value="cue1">Same as Cue 1</option>
                <option value="cue2">Same as Cue 2</option>
            </select>
        </SettingRow>
    </SettingGroup>

    <SettingGroup id="view" title="View">
        <SettingRow id="theme" name="Theme" description="Light, dark or as your system." for="theme-input">
            <select id="theme-input" aria-describedby="theme-description" data-setting="theme">
                <option value="system">System</option>
                <option value="light">Light</option>
                <option value="dark">Dark</option>
            </select>
        </SettingRow>
        <SettingRow
            id="show-digital"
            name="Digital inputs"
            description="S/PDIF and ADAT channels."
            for="show-digital-input">
            <input
                id="show-digital-input"
                type="checkbox"
                role="switch"
                aria-describedby="show-digital-description"
                data-setting="show-digital"
            />
        </SettingRow>
        <SettingRow
            id="show-loopback"
            name="Loopback"
            description="Apps playing to LOOPBACK L/R. Hidden, it still plays."
            for="show-loopback-input">
            <input
                id="show-loopback-input"
                type="checkbox"
                role="switch"
                aria-describedby="show-loopback-description"
                data-setting="show-loopback"
            />
        </SettingRow>
    </SettingGroup>

    <SettingGroup id="desktop" title="Desktop app">
        <SettingRow id="start-at-login" name="Auto start" description="When you sign in." for="start-at-login-input">
            <input
                id="start-at-login-input"
                type="checkbox"
                role="switch"
                aria-describedby="start-at-login-description"
                data-desktop="startAtLogin"
            />
        </SettingRow>
        <p class="hint" data-desktop-login-status hidden></p>
        <fieldset class="choices" data-desktop-login-start hidden>
            <legend class="visually-hidden">When it starts at sign-in</legend>
            <label>
                <input type="radio" name="login-start" value="tray" data-desktop="loginStart" />
                Minimise to tray
            </label>
            <label>
                <input type="radio" name="login-start" value="window" data-desktop="loginStart" />
                Open to desktop
            </label>
        </fieldset>
        <SettingRow
            id="minimise-to-tray"
            name="Minimise to tray"
            description="Off: it minimises to the taskbar."
            for="minimise-to-tray-input">
            <input
                id="minimise-to-tray-input"
                type="checkbox"
                role="switch"
                aria-describedby="minimise-to-tray-description"
                data-desktop="minimiseToTray"
            />
        </SettingRow>
        <SettingRow id="close-to-tray" name="Close to tray" description="Off: closing quits." for="close-to-tray-input">
            <input
                id="close-to-tray-input"
                type="checkbox"
                role="switch"
                aria-describedby="close-to-tray-description"
                data-desktop="closeToTray"
            />
        </SettingRow>
        <SettingRow
            id="dim-on-sleep"
            name="Volt display off at sleep"
            description="And at shutdown. It turns back on when Volt Mixer next connects."
            for="dim-on-sleep-input">
            <input
                id="dim-on-sleep-input"
                type="checkbox"
                role="switch"
                aria-describedby="dim-on-sleep-description"
                data-desktop="dimOnSleep"
            />
        </SettingRow>
        <SettingRow
            id="phone-remote"
            name="Phone remote"
            description="Change levels from your phone, on the same Wi-Fi. To carry your mix instead, use Your mix › QR code."
            for="phone-remote-input">
            <input
                id="phone-remote-input"
                type="checkbox"
                role="switch"
                aria-describedby="phone-remote-description"
                data-desktop="phoneRemote"
            />
        </SettingRow>
        <PhoneRemote />
        <SettingRow id="updates" name="Updates" description="Asks GitHub for a newer version.">
            <button class="button" type="button" aria-describedby="updates-description" data-action="check-update">
                Check
            </button>
        </SettingRow>
        <p class="hint" role="status" data-update-status></p>
    </SettingGroup>

    <SettingGroup id="your-mix" title="Your mix">
        <!-- The link fills the width; a click on it (or the button) copies it (mix-link.ts). -->
        <SettingRow
            id="mix-link"
            name="Mix link"
            description="Open it on another computer to use this mix there."
            for="mix-link-input"
            isStacked>
            <LinkField
                id="mix-link-input"
                type="text"
                readonly
                aria-describedby="mix-link-description message-mix-link"
                data-mix-link>
                <FeedbackButton variant="icon" data-mix-copy>
                    <Icon name="copy" />
                    <span class="visually-hidden">Copy mix link</span>
                </FeedbackButton>
            </LinkField>
            <Reveal summary="QR code" data-mix-qr>
                <QrCode name="mix" label="QR code of this mix link">
                    <p class="hint">
                        Scan it with your phone to carry the mix, or with another computer's camera to use it there.
                    </p>
                </QrCode>
            </Reveal>
            <InlineMessage name="mix-link" />
        </SettingRow>
        <!-- A link from another computer, pasted here; it replaces this computer's mix (controller.ts). -->
        <MixPasteForm
            id="mix-paste"
            name="Use a mix link"
            description="From another computer. It replaces this one's mix."
        />
        <SettingRow id="push-mix" name="Apply mix" description="Send it to the Volt now.">
            <button class="button" type="button" aria-describedby="push-mix-description" data-action="push-mix">
                Apply
            </button>
        </SettingRow>
        <SettingRow id="forget-mix" name="Forget mix" description="The Volt keeps playing.">
            <button class="button" type="button" aria-describedby="forget-mix-description" data-action="forget-mix">
                Forget
            </button>
        </SettingRow>
    </SettingGroup>

    <SettingGroup id="about" title="About">
        <SettingRow id="about-version" name="Volt Mixer" description={`Version ${site.version}`} />
        <!-- The Volt's firmware and serial, written in when it connects (connection-view.ts). -->
        <SettingRow id="about-volt" name="This Volt" description="Not connected." />
        <p class="hint">Sample rate and clock are set in Windows or your audio app.</p>
    </SettingGroup>
</Dialog>

<style>
    /* The two ways to start at sign-in, under Auto start. */
    .choices:not([hidden]) {
        display: grid;
        gap: var(--space-between-lines);
        padding-inline-start: var(--space-between-content);
    }

    .choices > label {
        display: flex;
        align-items: center;
        gap: var(--space-between-text);
        min-block-size: var(--size-action-minimum);
    }
</style>
