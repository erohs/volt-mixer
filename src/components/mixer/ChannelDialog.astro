---
import { channelIcons } from "../../lib/channel-icons.ts";
import { faderTicks } from "../../lib/taper.ts";
import Dialog from "../ui/Dialog.astro";
import Icon from "../ui/Icon.astro";
import SettingGroup from "../ui/SettingGroup.astro";
import SettingRow from "../ui/SettingRow.astro";
import Slider from "../ui/Slider.astro";

const panTicks = [
    { label: "L", position: 0 },
    { label: "C", position: 0.5 },
    { label: "R", position: 1 },
];
const gainTicks = [0, 20, 40, 60].map((db) => ({ label: `${db}`, position: db / 60 }));
const sendTicks = faderTicks().filter((tick) => ["+12", "0", "−12", "−40", "−∞"].includes(tick.label));
const tones = ["Off", "Warmth", "Focus", "Shine"];
const autoGainChoices = [5, 10, 15, 20, 30, 45, 60, 90];
const cues = [
    { cue: "cue1", title: "Cue 1" },
    { cue: "cue2", title: "Cue 2" },
];
---

<Dialog id="channel-dialog" title="Channel settings">
    <!--
        The channel as its strip shows it: its icon (a button that drops down the icon list) and its
        name (an editable title on the dialog's own background), in one card. channel-icon.ts.
    -->
    <section class="identity" aria-labelledby="identity-heading" data-channel-icon>
        <h3 class="identity-title" id="identity-heading">
            Name and icon
        </h3>
        <div class="identity-line">
            <button
                class="button icon-toggle"
                type="button"
                aria-expanded="false"
                aria-controls="channel-icon-list"
                data-channel-icon-toggle>
                <span class="current-icon" data-channel-icon-current></span>
                <Icon name="chevron-down" class="chevron" />
            </button>
            <div class="name">
                <label class="visually-hidden" for="channel-name-input">
                    Channel name
                </label>
                <input
                    id="channel-name-input"
                    type="text"
                    maxlength="24"
                    autocomplete="off"
                    data-channel-field="name"
                />
                <Icon name="pencil" class="pencil" />
            </div>
        </div>
        <fieldset id="channel-icon-list" class="icons" hidden>
            <legend class="visually-hidden">Icon</legend>
            <div class="icon-choices">
                {Object.entries(channelIcons).map(([icon, label]) => (
                    <label class="icon-choice" title={label}>
                        <input type="radio" name="channel-icon" value={icon} data-channel-icon-field="icon" />
                        <Icon name={icon} />
                        <span class="visually-hidden">{label}</span>
                    </label>
                ))}
            </div>
        </fieldset>
        <div data-channel-tray-show hidden>
            <SettingRow id="show-in-tray" name="Show in tray" for="show-in-tray-input">
                <input id="show-in-tray-input" type="checkbox" role="switch" data-channel-icon-field="show" />
            </SettingRow>
        </div>
    </section>

    <div data-channel-section="preamp">
        <SettingGroup id="preamp" title="Preamp">
            <div data-channel-section="gain">
                <SettingRow id="gain" name="Gain">
                    <Slider kind="gain" name="gain" labelledBy="gain-name" ticks={gainTicks} />
                </SettingRow>
            </div>
            <p class="note" data-channel-section="fixed-gain">
                Line inputs have fixed gain.
            </p>
            <div data-channel-section="phantom">
                <SettingRow id="phantom" name="48V phantom power" description="Condenser mics only.">
                    <button
                        class="button button--phantom"
                        type="button"
                        aria-pressed="false"
                        aria-labelledby="phantom-name"
                        aria-describedby="phantom-description"
                        data-channel-action="phantom">
                        48V
                    </button>
                </SettingRow>
            </div>
            <fieldset class="tones">
                <legend class="tones-legend">Tone</legend>
                <div class="tone-choices">
                    {tones.map((tone, index) => (
                        <label class="tone" data-tone={tone.toLowerCase()}>
                            <input type="radio" name="tone" value={index} data-channel-field="tone" />
                            <span>{tone}</span>
                        </label>
                    ))}
                </div>
            </fieldset>
            <div data-channel-section="gain">
                <SettingRow id="auto-gain" name="Auto-Gain" description="Play your loudest part." for="auto-gain-input">
                    <select
                        id="auto-gain-input"
                        aria-describedby="auto-gain-description"
                        data-channel-field="auto-gain-seconds">
                        {autoGainChoices.map((seconds) => (
                            <option value={seconds} selected={seconds === 10}>
                                {seconds} s
                            </option>
                        ))}
                    </select>
                    <button
                        class="button"
                        type="button"
                        aria-describedby="auto-gain-description"
                        data-channel-action="auto-gain">
                        Start
                    </button>
                </SettingRow>
                <p class="note" role="status" data-auto-gain-status></p>
            </div>
        </SettingGroup>
    </div>

    <SettingGroup id="monitor-mix" title="Monitor mix">
        <SettingRow id="pan-0" name="Pan">
            <Slider kind="pan" name="pan-0" labelledBy="pan-0-name" ticks={panTicks} />
        </SettingRow>
        <div data-channel-section="stereo">
            <SettingRow id="pan-1" name="Right pan">
                <Slider kind="pan" name="pan-1" labelledBy="pan-1-name" ticks={panTicks} />
            </SettingRow>
        </div>
    </SettingGroup>

    {cues.map(({ cue, title }) => (
        <SettingGroup id={cue} title={title} isCollapsible>
            <SettingRow id={`${cue}-level`} name="Send" description="Before the fader.">
                <Slider
                    kind="fader"
                    name={`${cue}-level`}
                    labelledBy={`${cue}-heading ${cue}-level-name`}
                    describedBy={`${cue}-level-description`}
                    ticks={sendTicks}
                />
            </SettingRow>
            <SettingRow id={`${cue}-pan-0`} name="Pan">
                <Slider
                    kind="pan"
                    name={`${cue}-pan-0`}
                    labelledBy={`${cue}-heading ${cue}-pan-0-name`}
                    ticks={panTicks}
                />
            </SettingRow>
            <div data-channel-section="stereo">
                <SettingRow id={`${cue}-pan-1`} name="Right pan">
                    <Slider
                        kind="pan"
                        name={`${cue}-pan-1`}
                        labelledBy={`${cue}-heading ${cue}-pan-1-name`}
                        ticks={panTicks}
                    />
                </SettingRow>
            </div>
            <SettingRow id={`${cue}-mute`} name="Mute" for={`${cue}-mute-input`}>
                <input id={`${cue}-mute-input`} type="checkbox" role="switch" data-channel-field={`${cue}-mute`} />
            </SettingRow>
        </SettingGroup>
    ))}
</Dialog>

<style>
    .note {
        color: var(--color-text-secondary);
        font-size: var(--font-size-small);
    }

    /* The card, tinted like a setting group, holding the line and the icon list below it. */
    .identity {
        --slider-surround: var(--color-background-raised);

        display: grid;
        gap: var(--space-between-content);
        padding: var(--space-padding-compact);
        border-radius: var(--radius-medium);
        background-color: var(--color-background-raised);
    }

    /* Titled like the setting groups below it. */
    .identity-title {
        font-size: var(--font-size-heading);
        font-weight: var(--font-weight-semi-bold);
    }

    .identity-line {
        display: flex;
        align-items: center;
        gap: var(--space-between-text);
    }

    /* The current icon with a small chevron; it turns while the list is open. */
    .icon-toggle {
        gap: 0.125rem;
        min-block-size: 2.75rem;
        padding: 0 var(--space-between-text);
        border-color: transparent;
        background-color: var(--color-background-surface);

        & .current-icon {
            display: inline-grid;
        }

        & :global(.icon) {
            inline-size: var(--size-icon);
            block-size: var(--size-icon);
        }

        & :global(.chevron) {
            inline-size: 0.875rem;
            block-size: 0.875rem;
            color: var(--color-text-secondary);
            transition: rotate var(--duration-fast) var(--easing-standard);
        }

        &[aria-expanded="true"] :global(.chevron) {
            rotate: 180deg;
        }
    }

    /* An editable title: no border, the dialog's own background and a pencil mark it as one. */
    .name {
        position: relative;
        flex: 1;
        min-inline-size: 0;

        & input {
            inline-size: 100%;
            min-block-size: 2.75rem;
            padding-inline: var(--space-padding-compact)
                calc(var(--space-padding-compact) + var(--size-icon) + var(--space-between-text));
            border: 0;
            border-radius: var(--radius-small);
            background-color: var(--color-background-surface);
            font-size: var(--font-size-heading);
            font-weight: var(--font-weight-semi-bold);

            &::placeholder {
                color: var(--color-text-secondary);
            }
        }

        & :global(.pencil) {
            position: absolute;
            inset-block-start: 50%;
            inset-inline-end: var(--space-padding-compact);
            inline-size: var(--size-icon);
            block-size: var(--size-icon);
            color: var(--color-text-secondary);
            translate: 0 -50%;
            pointer-events: none;
        }
    }

    .tones {
        display: grid;
        gap: var(--space-between-text);
        margin: 0;
        padding: 0;
        border: 0;
    }

    .tones-legend {
        margin-block-end: var(--space-between-text);
        padding: 0;
        font-weight: var(--font-weight-semi-bold);
    }

    .tone-choices {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(5.5rem, 1fr));
        gap: var(--space-between-text);
    }

    /* A native radio drawn as a segment; the checked one takes its TONE ring colour. */
    .tone {
        --tone-fill: var(--color-background-surface);
        --tone-text: var(--color-text-primary);

        position: relative;
        display: grid;
        place-items: center;
        min-block-size: var(--size-action-minimum);
        border: var(--border-width-default) solid var(--color-border);
        border-radius: var(--radius-small);
        background-color: var(--color-background-surface);
        font-size: var(--font-size-small);
        font-weight: var(--font-weight-semi-bold);
        cursor: pointer;

        & input {
            position: absolute;
            inset: 0;
            margin: 0;
            opacity: 0;
            cursor: pointer;
        }

        &:has(:checked) {
            border: var(--border-width-standout) solid var(--color-text-primary);
            background-color: var(--tone-fill);
            color: var(--tone-text);
        }

        &:has(:focus-visible) {
            outline: var(--border-width-highlight) solid var(--color-focus);
            outline-offset: 2px;
        }

        &:has(:disabled) {
            cursor: not-allowed;
            opacity: 0.6;
        }
    }

    .tone[data-tone="warmth"] {
        --tone-fill: var(--color-tone-warmth);
        --tone-text: var(--color-text-on-tone);
    }

    .tone[data-tone="focus"] {
        --tone-fill: var(--color-tone-focus);
        --tone-text: var(--color-text-on-tone);
    }

    .tone[data-tone="shine"] {
        --tone-fill: var(--color-tone-shine);
        --tone-text: var(--color-text-on-tone);
    }

    @media (forced-colors: active) {
        .name input {
            border: 1px solid CanvasText;
        }

        .tone:has(:checked) {
            outline: var(--border-width-standout) solid Highlight;
        }
    }

    /* Like the tone choices: the label is the button, its radio sits invisibly on top. */
    .icons:not([hidden]) {
        display: grid;
        gap: var(--space-between-text);
        margin: 0;
        padding: 0;
        border: 0;
    }

    .icon-choices {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(var(--size-action-minimum), 1fr));
        gap: var(--space-between-lines);
    }

    .icon-choice {
        position: relative;
        display: grid;
        place-items: center;
        aspect-ratio: 1;
        border: var(--border-width-default) solid transparent;
        border-radius: var(--radius-small);
        color: var(--color-text-primary);
        cursor: pointer;

        & input {
            position: absolute;
            inset: 0;
            margin: 0;
            opacity: 0;
            cursor: pointer;
        }

        & :global(.icon) {
            inline-size: var(--size-icon);
            block-size: var(--size-icon);
        }

        &:hover {
            border-color: var(--color-border);
        }

        &:has(:checked) {
            border-color: var(--color-background-accent);
            background-color: var(--color-background-accent);
            color: var(--color-text-on-accent);
        }

        &:has(:focus-visible) {
            outline: var(--border-width-highlight) solid var(--color-focus);
            outline-offset: 2px;
        }

        &:has(:disabled) {
            cursor: not-allowed;
            opacity: 0.6;
        }
    }
</style>
