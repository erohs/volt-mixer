---
import MixPasteForm from "./MixPasteForm.astro";
import Reveal from "../ui/Reveal.astro";
---

<!--
    Shown when this computer has no mix for the connected Volt: the first time, or after Forget mix.
    The Volt can't report its fader positions, so the page needs a mix of its own before it sends
    any level (as Console does). Starting fresh is the one big choice; bringing a mix folds away.
-->
<section class="setup message-box message-box--panel" aria-labelledby="setup-heading" data-mix-setup hidden>
    <h2 id="setup-heading">Welcome to Volt Mixer on this computer</h2>
    <p>Your Volt is connected. Choose a mix to start from, and the faders start working.</p>
    <div class="start">
        <button
            class="button button--primary"
            type="button"
            data-action="mix-defaults"
            aria-describedby="defaults-hint">
            Start a new mix
        </button>
        <span id="defaults-hint" class="hint">
            Every channel at 0 dB, like a new UAD Console session.
        </span>
    </div>
    <Reveal summary="Bring my mix from another computer or phone">
        <div class="paste">
            <MixPasteForm
                id="mix-setup-paste"
                name="Paste its mix link"
                description="Opening the link on this computer works too."
            />
        </div>
    </Reveal>
    <p class="hint">This shows on each new computer, and after Forget mix.</p>
</section>

<style>
    .setup:not([hidden]) {
        margin-block-start: var(--space-between-blocks);
        margin-inline: var(--space-page-inline);
    }

    .start {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-between-text) var(--space-between-content);
    }

    /* As wide as a link needs, and in body text, though the fold-out's own text is small. */
    .paste {
        max-inline-size: 40rem;
        color: var(--color-text-primary);
        font-size: var(--font-size-body);
    }
</style>
