---
interface Props {
    summary: string;
    /** data-* attributes for the scripts, e.g. data-mix-qr. */
    [attribute: `data-${string}`]: string | boolean;
}

const { summary, ...attributes } = Astro.props;
---

<!-- Something that folds out on demand (a QR code, help): small accent text with the native marker. -->
<details class="reveal" {...attributes}>
    <summary>{summary}</summary>
    <slot />
</details>

<style>
    .reveal {
        color: var(--color-text-secondary);
        font-size: var(--font-size-small);

        & summary {
            color: var(--color-text-accent);
            cursor: pointer;
        }

        & > :global(:not(summary)) {
            margin-block-start: var(--space-between-text);
        }

        & :global(ul) {
            display: grid;
            gap: var(--space-between-lines);
            padding-inline-start: 1.25rem;
        }
    }
</style>
