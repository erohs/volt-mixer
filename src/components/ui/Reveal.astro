---
interface Props {
    summary: string;
    /** data-* attributes for the scripts, e.g. data-mix-qr. */
    [attribute: `data-${string}`]: string | boolean;
}

const { summary, ...attributes } = Astro.props;
---

<!-- Something that folds out on demand (a QR code, help): small accent text with the native marker. -->
<details class="reveal" {...attributes}>
    <summary class="reveal-summary">{summary}</summary>
    <slot />
</details>

<style>
    .reveal {
        color: var(--color-text-secondary);
        font-size: var(--font-size-small);
    }

    .reveal-summary {
        color: var(--color-text-accent);
        cursor: pointer;
    }

    /* What it folds out is slotted: spaced from the summary, and a list set out like the page's. */
    .reveal > :global(:not(summary)) {
        margin-block-start: var(--space-between-text);
    }

    .reveal > :global(ul) {
        display: grid;
        gap: var(--space-between-lines);
        padding-inline-start: 1.25rem;
    }
</style>
