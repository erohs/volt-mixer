---
interface Props {
    /** Names the code for its script (data-qr); the code is drawn by src/scripts/qr.ts. */
    name: string;
    /** Spoken for the image: what scanning it does. */
    label: string;
}

const { name, label } = Astro.props;
---

<!-- A QR code, centred, with the slot's line under it. Black on white in any theme, so cameras read it. -->
<div class="code">
    <svg class="qr" role="img" aria-label={label} data-qr={name}>
        <path></path>
    </svg>
    <slot />
</div>

<style>
    .code {
        display: grid;
        justify-items: center;
        gap: var(--space-between-text);
        text-align: center;
    }

    .qr {
        inline-size: min(16rem, 100%);
        aspect-ratio: 1;
        border-radius: var(--radius-medium);
        background-color: #ffffff;
        color: #000000;
        fill: currentColor;
        shape-rendering: crispEdges;
        forced-color-adjust: none;
    }
</style>
