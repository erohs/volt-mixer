---
import type { HTMLAttributes } from "astro/types";

/*
 * A box and its button as one field: they share a border, squared off where they meet. The props
 * go to the box; the button is the slot. Used for the mix links (MixPasteForm.astro, Settings).
 */
type Props = HTMLAttributes<"input">;
---

<div class="link-field">
    <input class="link-input" {...Astro.props} />
    <slot />
</div>

<style>
    .link-field {
        display: flex;
    }

    .link-input {
        flex: 1;
        min-inline-size: 0;
        border-start-end-radius: 0;
        border-end-end-radius: 0;
        font-size: var(--font-size-small);
        text-overflow: ellipsis;
    }

    /* The link to copy reads as quieter than one being typed. */
    .link-input[readonly] {
        color: var(--color-text-secondary);
        cursor: copy;
    }

    /* The slotted button, joined on. */
    .link-field > :global(.button) {
        border-inline-start: 0;
        border-start-start-radius: 0;
        border-end-start-radius: 0;
    }

    /* The focused one sits on top, so its outline isn't hidden under its neighbour. */
    .link-input:focus-visible,
    .link-field > :global(:focus-visible) {
        position: relative;
        z-index: var(--z-index-raised);
    }
</style>
