---
import type { ITick } from "../../lib/taper.ts";

interface Props {
    /** Which model in src/lib/slider-models.ts drives it. */
    kind: "fader" | "pan" | "level" | "gain" | "brightness";
    /** IDs of elements that name and describe it (e.g. a setting row); without them the script names it. */
    labelledBy?: string;
    describedBy?: string;
    orientation?: "vertical" | "horizontal";
    ticks?: ITick[];
    /** Names the slider for the script (data-slider). */
    name: string;
}

const { kind, labelledBy, describedBy, orientation = "horizontal", ticks = [], name } = Astro.props;
---

<div class="slider" data-orientation={orientation}>
    {ticks.length > 0 && (
        <ol class="scale" aria-hidden="true">
            {ticks.map((tick) => (
                <li class="tick" style={`--tick: ${tick.position}`}>
                    {tick.label}
                </li>
            ))}
        </ol>
    )}
    <div
        class="control"
        role="slider"
        tabindex="0"
        aria-labelledby={labelledBy}
        aria-describedby={describedBy}
        aria-orientation={orientation}
        aria-valuemin="0"
        aria-valuemax="1"
        aria-valuenow="0"
        data-slider={name}
        data-kind={kind}>
        <span class="track">
            <span class="fill"></span>
        </span>
        <span class="thumb"></span>
    </div>
    <span class="value" aria-hidden="true" data-slider-value={name}></span>
</div>

<style>
    /*
     * --slider-position (0–1) is set by src/scripts/slider.ts. The thumb travels the track minus
     * its own size, so 0 and 1 sit exactly at the ends and every slider of a kind lines up.
     */
    .slider {
        --slider-position: 0;
        --slider-travel: calc(100% - var(--size-slider-thumb));

        display: grid;
        gap: var(--space-between-lines);
        font-size: var(--font-size-meta);
        user-select: none;
    }

    /*
     * Only the control takes the pointer, and only along its own axis: a swipe across it still
     * scrolls the page (the browser cancels the drag), which matters on a phone full of sliders.
     */
    .control {
        position: relative;
        border-radius: var(--radius-small);
        cursor: grab;
    }

    .control:active {
        cursor: grabbing;
    }

    /* The ring goes on the handle, not the whole slider. */
    .control:focus-visible {
        outline: none;
    }

    /*
     * Focused or being dragged, the handle gets a ring in its own colour, set off by a gap in the
     * colour behind the slider (--slider-surround, which SettingGroup sets to its tint). The gap
     * hides the track and fill under it, so the ring contrasts all the way round.
     */
    .control:is(:focus-visible, :active) .thumb {
        box-shadow:
            0 0 0 2px var(--slider-surround, var(--color-background-surface)),
            0 0 0 calc(2px + var(--border-width-highlight)) var(--slider-colour, var(--color-background-accent));
    }

    .track {
        position: absolute;
        overflow: hidden;
        border-radius: var(--size-slider-track);
        background-color: var(--color-background-track);
    }

    /* --slider-colour lets a parent tint it, as a strip does with its TONE colour (tone.css). */
    .fill {
        position: absolute;
        background-color: var(--slider-colour, var(--color-background-accent));
    }

    .thumb {
        position: absolute;
        inline-size: var(--size-slider-thumb);
        block-size: var(--size-slider-thumb);
        border-radius: 50%;
        /* Its colour reaches 3:1 on the track and the card (src/styles/tokens.test.ts). */
        background-color: var(--slider-colour, var(--color-background-accent));
    }

    /* Pan rests at the centre, so a fill from one end would mislead. */
    .control[data-kind="pan"] .fill {
        display: none;
    }

    .value {
        color: var(--color-text-primary);
        font-size: var(--font-size-small);
        font-weight: var(--font-weight-semi-bold);
        font-variant-numeric: tabular-nums;
    }

    .scale {
        position: relative;
        padding: 0;
        color: var(--color-text-secondary);
        list-style: none;
        font-variant-numeric: tabular-nums;
        line-height: 1;
    }

    .tick {
        position: absolute;
    }

    .slider:where([data-orientation="vertical"]) {
        grid-template: "scale control" var(--size-fader-length) "value value" auto / auto var(--size-slider-thumb);
        column-gap: var(--space-between-text);
        justify-content: center;
    }

    .slider:where([data-orientation="vertical"]) > .control {
        grid-area: control;
        touch-action: pan-x;
    }

    .slider:where([data-orientation="vertical"]) .track {
        inset-block: calc(var(--size-slider-thumb) / 2);
        inset-inline-start: calc(50% - var(--size-slider-track) / 2);
        inline-size: var(--size-slider-track);
    }

    .slider:where([data-orientation="vertical"]) .fill {
        inset-block: auto 0;
        inset-inline: 0;
        block-size: calc(var(--slider-position) * 100%);
    }

    .slider:where([data-orientation="vertical"]) .thumb {
        inset-block-end: calc(var(--slider-position) * var(--slider-travel));
        inset-inline-start: 0;
    }

    .slider:where([data-orientation="vertical"]) > .scale {
        grid-area: scale;
        min-inline-size: 2.25rem;
        text-align: end;
    }

    .slider:where([data-orientation="vertical"]) .tick {
        inset-inline-end: 0;
        inset-block-end: calc(var(--tick) * var(--slider-travel) + var(--size-slider-thumb) / 2);
        translate: 0 50%;
    }

    .slider:where([data-orientation="vertical"]) > .value {
        grid-area: value;
        text-align: center;
    }

    .slider:where([data-orientation="horizontal"]) {
        grid-template: "control value" var(--size-slider-thumb) "scale ." auto / 1fr 4rem;
        column-gap: var(--space-between-text);
        align-items: center;
    }

    .slider:where([data-orientation="horizontal"]) > .control {
        grid-area: control;
        block-size: var(--size-slider-thumb);
        touch-action: pan-y;
    }

    .slider:where([data-orientation="horizontal"]) .track {
        inset-block-start: calc(50% - var(--size-slider-track) / 2);
        inset-inline: calc(var(--size-slider-thumb) / 2);
        block-size: var(--size-slider-track);
    }

    .slider:where([data-orientation="horizontal"]) .fill {
        inset-block: 0;
        inset-inline: 0 auto;
        inline-size: calc(var(--slider-position) * 100%);
    }

    .slider:where([data-orientation="horizontal"]) .thumb {
        inset-inline-start: calc(var(--slider-position) * var(--slider-travel));
        inset-block-start: 0;
    }

    .slider:where([data-orientation="horizontal"]) > .scale {
        grid-area: scale;
        block-size: 1em;
    }

    .slider:where([data-orientation="horizontal"]) .tick {
        inset-inline-start: calc(var(--tick) * var(--slider-travel) + var(--size-slider-thumb) / 2);
        translate: -50% 0;
    }

    .slider:where([data-orientation="horizontal"]) > .value {
        grid-area: value;
        text-align: end;
    }

    @media (forced-colors: active) {
        .fill,
        .thumb {
            background-color: CanvasText;
        }

        /* Box shadows aren't drawn in forced colours, so the ring is an outline there. */
        .control:is(:focus-visible, :active) .thumb {
            outline: var(--border-width-highlight) solid Highlight;
            outline-offset: 2px;
        }
    }
</style>
