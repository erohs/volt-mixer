---
import { zoneStops } from "../../lib/meters.ts";

interface Props {
    /** The meter's name in the protocol data (spec.reports.meters.offsets). */
    name: string;
    orientation?: "vertical" | "horizontal";
}

const { name, orientation = "vertical" } = Astro.props;
const zones = `--meter-caution: ${zoneStops.caution * 100}%; --meter-danger: ${zoneStops.danger * 100}%;`;
---

<div class="meter" data-meter={name} data-orientation={orientation} style={zones} aria-hidden="true">
    <span class="clip" data-meter-clip></span>
    <span class="bar">
        <span class="cover"></span>
    </span>
</div>

<style>
    /*
     * The bar is painted in its zone colours along its whole length and a cover hides what is above
     * the level (--meter-level, 0–1, set by the script), so colour follows position like Console.
     */
    .meter {
        --meter-level: 0;
        --meter-zones: linear-gradient(
            var(--meter-direction),
            var(--color-meter-safe) var(--meter-caution),
            var(--color-meter-caution) var(--meter-caution) var(--meter-danger),
            var(--color-meter-danger) var(--meter-danger)
        );

        display: grid;
        gap: 2px;
    }

    .bar {
        position: relative;
        overflow: hidden;
        border-radius: 2px;
        background: var(--meter-zones);
    }

    .cover {
        position: absolute;
        background-color: var(--color-background-track);
    }

    .clip {
        border-radius: 2px;
        background-color: var(--color-background-track);
    }

    .meter[data-clipped] .clip {
        background-color: var(--color-meter-danger);
    }

    .meter:where([data-orientation="vertical"]) {
        --meter-direction: to top;

        grid-template-rows: var(--size-meter) 1fr;
        inline-size: var(--size-meter);
    }

    .meter:where([data-orientation="vertical"]) .cover {
        inset-block: 0 auto;
        inset-inline: 0;
        block-size: calc((1 - var(--meter-level)) * 100%);
    }

    /* Fills from the inline start, so it follows the text's direction; the clip light is at the end. */
    .meter:where([data-orientation="horizontal"]) {
        --meter-direction: to right;

        grid-template-columns: 1fr var(--size-meter);
        block-size: var(--size-meter);
    }

    .meter:where([data-orientation="horizontal"]:dir(rtl)) {
        --meter-direction: to left;
    }

    .meter:where([data-orientation="horizontal"]) .bar {
        grid-column: 1;
        grid-row: 1;
    }

    .meter:where([data-orientation="horizontal"]) .clip {
        grid-column: 2;
        grid-row: 1;
    }

    .meter:where([data-orientation="horizontal"]) .cover {
        inset-block: 0;
        inset-inline: auto 0;
        inline-size: calc((1 - var(--meter-level)) * 100%);
    }

    @media (forced-colors: active) {
        .bar {
            background: CanvasText;
        }

        .cover,
        .clip {
            border: var(--border-width-default) solid CanvasText;
            background-color: Canvas;
        }
    }
</style>
