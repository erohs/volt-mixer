---
import Icon from "./Icon.astro";

interface Props {
    id: string;
    title: string;
}

const { id, title } = Astro.props;
---

<!-- As wide as --dialog-size, which a dialog's own stylesheet can set (default --size-dialog). -->
<dialog id={id} class="dialog" aria-labelledby={`${id}-title`}>
    <div class="head">
        <h2 id={`${id}-title`} data-dialog-title>
            {title}
        </h2>
        <form method="dialog">
            <button class="button button--icon" type="submit">
                <Icon name="close" />
                <span class="visually-hidden">Close</span>
            </button>
        </form>
    </div>
    <div class="body">
        <slot />
    </div>
</dialog>

<style>
    .dialog {
        inline-size: var(--dialog-size, var(--size-dialog));
    }

    /* Only the body scrolls, so the scrollbar starts below the header instead of beside it. */
    .dialog[open] {
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .head {
        display: flex;
        flex: none;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-between-content);
        padding-block: var(--space-between-text);
        padding-inline: var(--space-padding-container) var(--space-between-text);
        border-block-end: var(--border-width-default) solid var(--color-border-subtle);
        background-color: var(--color-background-surface);
    }

    .body {
        display: grid;
        gap: var(--space-between-blocks);
        min-block-size: 0;
        padding: var(--space-padding-container);
        overflow-y: auto;
        overscroll-behavior: contain;
    }
</style>
