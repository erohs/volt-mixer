---
interface Props {
    /** Prefix for the name and description IDs (`<id>-name`, `<id>-description`), for the control to reference. */
    id: string;
    name: string;
    description?: string;
    /** The control's ID, when it's a native input the name can be a <label> for. */
    for?: string;
    /** The control below the name, across the full width (a link field). A slider is always stacked. */
    isStacked?: boolean;
}

const { id, name, description, for: forId, isStacked = false } = Astro.props;
---

<div class="setting" data-stacked={isStacked ? "" : undefined}>
    <div class="setting-text">
        {forId ? (
            <label class="setting-name" id={`${id}-name`} for={forId} data-setting-name={id}>
                {name}
            </label>
        ) : (
            <span class="setting-name" id={`${id}-name`} data-setting-name={id}>
                {name}
            </span>
        )}
        {description && (
            <p class="hint" id={`${id}-description`}>
                {description}
            </p>
        )}
    </div>
    <div class="setting-control">
        <slot />
    </div>
</div>

<style>
    .setting:not([hidden]) {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-between-text) var(--space-between-content);
    }

    .setting-text {
        display: grid;
        flex: 1 1 11rem;
        gap: 0.125rem;
    }

    .setting-name {
        font-weight: var(--font-weight-semi-bold);
    }

    .setting-control {
        display: flex;
        flex: 0 1 auto;
        flex-wrap: wrap;
        align-items: center;
        justify-content: end;
        gap: var(--space-between-text);
    }

    /* Stacked, or holding a slider (which needs the full width to travel): the control below the text. */
    .setting:is([data-stacked], :has(> .setting-control > :global(.slider))) {
        flex-direction: column;
        align-items: stretch;
    }

    .setting:is([data-stacked], :has(> .setting-control > :global(.slider))) > .setting-text {
        flex: none;
    }

    /* Its one column takes the full width; the row's `justify-content: end` would shrink it to its content. */
    .setting:is([data-stacked], :has(> .setting-control > :global(.slider))) > .setting-control {
        display: grid;
        justify-content: stretch;
        gap: var(--space-between-lines);
    }
</style>
