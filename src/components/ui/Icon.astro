---
interface Props {
    name: string;
    class?: string;
}

/*
 * The icons as text, inlined where they're used: imported as components they'd also be emitted as
 * files the page never loads.
 */
const icons = import.meta.glob<string>("../../icons/*.svg", { query: "?raw", import: "default", eager: true });
const { name, class: className } = Astro.props;
const svg = icons[`../../icons/${name}.svg`];

if (svg === undefined) {
    throw new Error(`No icon named "${name}" in src/icons.`);
}

const classes = ["icon", className].filter(Boolean).join(" ");
const markup = svg.replace("<svg ", `<svg class="${classes}" width="24" height="24" aria-hidden="true" `);
---

<Fragment set:html={markup} />

<style>
    /* Defaults only: no specificity, so a size or display set where the icon is placed always wins. */
    :global(:where(.icon)) {
        display: inline-block;
        flex-shrink: 0;
        inline-size: 1.1em;
        block-size: 1.1em;
        vertical-align: middle;
    }
</style>
