---
import type { MarkdownHeading } from "astro";
import GuideHeader from "../components/guide/GuideHeader.astro";
import GuideNav from "../components/guide/GuideNav.astro";
import GuideSearch from "../components/guide/GuideSearch.astro";
import Footer from "../components/site/Footer.astro";
import Icon from "../components/ui/Icon.astro";
import { guideHref, neighboursOf, type IGuidePage } from "../lib/guide-nav.ts";
import { site, websiteUrlOf } from "../lib/site.ts";
import BaseLayout from "./BaseLayout.astro";
/* Their own files, loaded only here, so the guide adds nothing to the mixer's stylesheet. */
import proseStyles from "../styles/guide-prose.css?url";
import searchStyles from "../styles/guide-search.css?url";
import guideStyles from "../styles/guide.css?url";

/* A guide page (src/pages/_website/guide/[...slug].astro): its place, front matter, headings and content. */
interface Props {
    slug: string;
    group: string;
    page: { title: string; description: string; lead: string };
    /** Every page, in order, for the sidebar and the previous and next links. */
    pages: IGuidePage[];
    headings: MarkdownHeading[];
}

const { slug, group, page, pages, headings } = Astro.props;
const base = import.meta.env.BASE_URL;
const { previous, next } = neighboursOf(pages, slug);
const sections = headings.filter((heading) => heading.depth === 2);
const guideUrl = websiteUrlOf(guideHref("", base), base);
const pageUrl = websiteUrlOf(guideHref(slug, base), base);
const crumbs = [
    { name: site.name, item: site.websiteUrl },
    { name: "Guide", item: guideUrl },
    ...(slug ? [{ name: page.title, item: pageUrl }] : []),
];
const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "TechArticle",
            headline: page.title,
            description: page.description,
            url: pageUrl,
            inLanguage: "en-GB",
            isPartOf: { "@type": "WebSite", name: `${site.name} guide`, url: guideUrl },
            about: { "@type": "WebApplication", name: site.name, url: site.websiteUrl },
        },
        {
            "@type": "BreadcrumbList",
            itemListElement: crumbs.map((crumb, i) => ({ "@type": "ListItem", position: i + 1, ...crumb })),
        },
    ],
};
---

<BaseLayout
    title={slug ? `${page.title} | Volt Mixer guide` : page.title}
    description={page.description}
    skipLabel="Skip to the guide"
    layout="guide"
    ogType="article"
    structuredData={structuredData}>
    <link slot="head" rel="stylesheet" href={guideStyles} />
    <link slot="head" rel="stylesheet" href={proseStyles} />
    <link slot="head" rel="stylesheet" href={searchStyles} />
    <GuideHeader slot="header" />
    <GuideNav slot="nav" pages={pages} current={slug} />
    <div class="guide-page">
        <header class="guide-title">
            <p class="guide-eyebrow">{group}</p>
            <h1>{page.title}</h1>
            <p class="guide-lead">{page.lead}</p>
        </header>
        {sections.length > 0 && (
            <nav class="guide-toc" aria-labelledby="guide-toc-heading">
                <h2 id="guide-toc-heading">On this page</h2>
                <ul>
                    {sections.map((section) => (
                        <li>
                            <a href={`#${section.slug}`}>{section.text}</a>
                        </li>
                    ))}
                </ul>
            </nav>
        )}
        <div class="guide-prose">
            <slot />
        </div>
        <nav class="guide-pager" aria-label="Previous and next pages">
            {previous && (
                <a class="guide-pager-link" href={guideHref(previous.slug, base)} rel="prev">
                    <span class="guide-pager-label">
                        <Icon name="arrow-left" />
                        Previous
                    </span>
                    {previous.title}
                </a>
            )}
            {next && (
                <a class="guide-pager-link guide-pager-next" href={guideHref(next.slug, base)} rel="next">
                    <span class="guide-pager-label">
                        Next
                        <Icon name="arrow-right" />
                    </span>
                    {next.title}
                </a>
            )}
        </nav>
    </div>
    <GuideSearch />
    <Footer slot="footer" />
</BaseLayout>

<script>
    import { wireGuideNav } from "../scripts/guide-nav.ts";
    import { wireGuideSearch } from "../scripts/guide-search.ts";

    wireGuideNav();
    wireGuideSearch();
</script>
